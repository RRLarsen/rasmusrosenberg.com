# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*

# environment variables (secrets go in GitHub Actions secrets, never in the repo)
.env
.env.*

# macOS
.DS_Store

# private material: never committed (the repo will be public)
private/

# source documents with private details (e.g. the CV has a date of birth); data/ is the public version
*.docx
*.doc
*.pages

# generated by the build (npm run build): the PDF CVs and their working files
cv/.build/
public/rasmus-rosenberg-larsen-cv.pdf

# suggestions inbox cache (CV builder); rebuilt on every check
generated/inbox.json
