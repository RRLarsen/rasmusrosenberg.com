---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import BuyLinks from '../components/BuyLinks.astro';
import Promo from '../components/Promo.astro';
import { getProfile, getPublications, getSite, isPublished } from '../lib/data';
import { getPromotions, type Promotion } from '../lib/promotions';
import { person } from '../lib/jsonld';
import Emph from '../components/Emph.astro';

const profile = await getProfile();
const site = await getSite();
const pubs = await getPublications();
const book = pubs.find((p) => p.data.type === 'book' && p.data.featured);
const expertise = (await getCollection('expertise', isPublished)).sort((a, b) => a.data.order - b.data.order);

// The rotating band: quotes, with promotions (any record marked featured: true) slotted in
// after the first quote. Promotions all use the Promo template.
type Slide = { kind: 'quote'; text: string } | { kind: 'promo'; promo: Promotion };
const quotes: Slide[] = site.quotes.map((text) => ({ kind: 'quote', text }));
const promos: Slide[] = (await getPromotions()).map((promo) => ({ kind: 'promo', promo }));
const slides: Slide[] = [...quotes.slice(0, 1), ...promos, ...quotes.slice(1)];
---
<Base jsonLd={person(profile, site.url)}>
  <Fragment slot="band">
    <div class="wrap opening">
      <div class="words">
        <h1 class="visually-hidden">{profile.name}</h1>
        <figure class="quotes" aria-roledescription="carousel" aria-label="Quotes and media">
          <div class="stack">
            {slides.map((sl, i) => (
              <div class="quote" id={`slide-${i}`} data-active={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
                {sl.kind === 'quote' ? (
                  <blockquote><p>“{sl.text}”</p></blockquote>
                ) : (
                  <Promo promo={sl.promo} active={i === 0} />
                )}
              </div>
            ))}
          </div>
          {slides.length > 1 && (
            <div class="dots" role="group" aria-label="Choose a slide">
              {slides.map((_, i) => (
                <button type="button" aria-controls={`slide-${i}`} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Slide ${i + 1} of ${slides.length}`}></button>
              ))}
            </div>
          )}
        </figure>
        <p class="who sans">{site.intro}</p>
      </div>
      <img class="portrait" src={profile.photo.portrait} width="1119" height="1400" alt={profile.photo.alt} />
    </div>
  </Fragment>

  {book && (
    <section class="sec" aria-labelledby="book-h">
      <div class="wrap book">
        {book.data.cover && (
          <picture>
            {/* on phones, a horizontal image of the book on turquoise; on wider screens, the cover */}
            <source media="(max-width: 820px)" srcset="/images/psychopathy-unmasked-wide.jpg" width="1440" height="900" />
            <img src={book.data.cover} width="600" height="900" alt={`Cover of ${book.data.title}`} />
          </picture>
        )}
        <div>
          <h2 id="book-h">{book.data.title}</h2>
          {book.data.subtitle && <p class="sub">{book.data.subtitle}</p>}
          {book.data.description && <p class="desc">{book.data.description}</p>}
          <p class="facts sans">{book.data.publisher}, {book.data.date?.slice(0, 4)}. {book.data.pages} pages.</p>
          <BuyLinks book={book} more={{ href: '/book/', label: 'More about the book' }} />
        </div>
      </div>
    </section>
  )}

  <Section title="Expertise" id="expertise">
    <p class="intro">{site.pages.expertise}</p>
    <div class="areas">
      {expertise.map((e) => (
        <div>
          <h3>{e.data.title}</h3>
          <p>{e.data.summary}</p>
        </div>
      ))}
    </div>
    <p class="more sans"><a href="/expertise/">More about consultation and talks</a></p>
  </Section>

  <Section title="About" id="about">
    <div class="prose">
      <p><Emph text={profile.bio.medium} /></p>
      <p class="sans"><a href="/about/">Biography and CV</a></p>
    </div>
  </Section>
</Base>

<script>
  // Rotating quotes: a new one every few seconds, or pick one with the dots.
  // Picking a quote stops the rotation; hovering pauses it; reduced motion turns it off.
  const box = document.querySelector<HTMLElement>('.quotes');
  const quotes = box ? [...box.querySelectorAll<HTMLElement>('.quote')] : [];
  const dots = box ? [...box.querySelectorAll<HTMLButtonElement>('.dots button')] : [];
  if (box && quotes.length > 1) {
    let current = 0;
    let timer: number | undefined;
    const show = (i: number) => {
      current = (i + quotes.length) % quotes.length;
      quotes.forEach((q, n) => {
        q.toggleAttribute('data-active', n === current);
        q.setAttribute('aria-hidden', String(n !== current));
        q.querySelectorAll('a').forEach((a) => (n === current ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      dots.forEach((d, n) => d.setAttribute('aria-pressed', String(n === current)));
    };
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => { if (!still) timer = window.setInterval(() => show(current + 1), 9000); };
    const stop = () => window.clearInterval(timer);
    dots.forEach((d, n) => d.addEventListener('click', () => { stop(); show(n); box.dataset.stopped = ''; }));
    box.addEventListener('mouseenter', stop);
    box.addEventListener('mouseleave', () => { if (!('stopped' in box.dataset)) start(); });
    start();
  }
</script>

<style>
  .opening {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: clamp(1.5rem, 3.5vw, 3rem); align-items: start;
    padding-top: clamp(1.25rem, 3vh, 2rem); padding-bottom: clamp(2rem, 5vh, 3rem);
  }
  .quotes { margin: 0; }
  /* every quote sits in the same grid cell, so the box is as tall as the longest one */
  .stack { display: grid; }
  .quote { grid-area: 1 / 1; margin: 0; opacity: 0; visibility: hidden; transition: opacity 0.6s ease, visibility 0s 0.6s; }
  .quote[data-active] { opacity: 1; visibility: visible; transition: opacity 0.6s ease; }
  @media (prefers-reduced-motion: reduce) { .quote, .quote[data-active] { transition: none; } }
  .quote blockquote { margin: 0; }
  .dots { display: flex; gap: 0.6rem; margin-top: 1.5rem; }
  .dots button {
    width: 0.7rem; height: 0.7rem; padding: 0; border-radius: 50%; cursor: pointer;
    border: 1px solid var(--on-deep-soft); background: transparent;
  }
  .dots button[aria-pressed="true"] { background: var(--on-deep); border-color: var(--on-deep); }
  .dots button:hover { border-color: var(--on-deep); }
  /* a larger tap target than the visible dot */
  .dots button { position: relative; }
  .dots button::before { content: ""; position: absolute; inset: -0.5rem; }
  .quote blockquote p {
    margin: -0.16em 0 0; max-width: 34ch; text-indent: -0.42em; /* pull the first line up so its capitals meet the top of the photo */
    font-weight: 300; font-size: clamp(1.625rem, 3vw, 2.75rem); line-height: 1.16; letter-spacing: -0.015em;
  }
  .who { margin: 2.25rem 0 0; color: var(--on-deep-soft); max-width: 34rem; }
  .portrait { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 25%; }

  .book { display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .book h2 { margin: 0; font-weight: 500; font-size: 2.25rem; line-height: 1.05; letter-spacing: -0.015em; }
  .sub { margin: 0.4rem 0 1.5rem; font-style: italic; font-size: var(--step-1); color: var(--ink-soft); }
  .desc { max-width: var(--measure); }
  .facts { color: var(--muted); }

  .intro { margin: 0; max-width: 40rem; font-size: var(--step-1); line-height: 1.45; }
  .areas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem clamp(1.5rem, 3vw, 2.5rem); margin-top: 2.5rem; }
  .areas h3 { margin: 0 0 0.5rem; font-weight: 500; font-size: var(--step-1); line-height: 1.2; }
  .areas p { margin: 0; color: var(--ink-soft); font-size: 1.0625rem; }

  .book picture { display: block; }
  .book img { display: block; width: 100%; height: auto; }

  @media (max-width: 820px) {
    .opening, .areas, .book { grid-template-columns: 1fr; }
    .quote blockquote p { text-indent: 0; font-size: 2rem; line-height: 1.18; }
    /* phones: quote or promotion, then the portrait (full width), then the credentials line */
    .words { display: contents; }
    .quotes { order: 1; }
    .portrait { order: 2; width: 100%; max-width: none; }
    .who { order: 3; margin-top: 0; }
    /* every slide shares the height of the tallest (the promotion), so centre the quotes in it */
    .quote { display: flex; flex-direction: column; justify-content: center; }
  }
</style>
