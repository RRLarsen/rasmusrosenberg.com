---
/* An open course: its introduction, downloads, and modules (data/modules.yaml), with each
   module's slides from the latest release in the course's GitHub repository. */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import Section from '../../components/Section.astro';
import Emph from '../../components/Emph.astro';
import { onWebsite, isPublished, courseFile, moduleSlides, splitTitle } from '../../lib/data';

export async function getStaticPaths() {
  const courses = (await getCollection('teaching', onWebsite)).filter((c) => c.data.open_course);
  return courses.map((course) => ({ params: { course: course.data.open_course }, props: { course } }));
}

interface Props { course: CollectionEntry<'teaching'> }
const { course } = Astro.props;
const modules = (await getCollection('modules', isPublished)).filter((m) => m.data.course === course.id).sort((a, b) => a.data.number - b.data.number);
const [name, subtitle] = splitTitle(course.data.title);
const paras = (text?: string) => (text ?? '').split(/\n\s*\n/).map((x) => x.trim()).filter(Boolean);
const description = `Open course materials (CC BY 4.0) for ${name}${course.data.code ? ` (${course.data.code})` : ''}: ${modules.length} modules with readings, aims, and PowerPoint slides, and a sample syllabus.`;
---
<Base title={`${name}: course materials`} description={description}>
  <PageHeading slot="band" title={name} intro={subtitle ? `${subtitle}. Open course materials.` : 'Open course materials.'} />

  <Section title="About the course" id="about">
    <div class="prose">
      {paras(course.data.materials_intro).map((p) => <p><Emph text={p} /></p>)}
    </div>
    <div class="downloads">
      <a class="button" href={courseFile(course, 'course-materials.zip')}>Download all materials (zip)</a>
      <p class="sans">
        Sample syllabus: <a href={courseFile(course, 'syllabus.pdf')}>PDF</a> · <a href={courseFile(course, 'syllabus.docx')}>Word</a>
        <span class="muted">The zip holds the slides for all {modules.length} modules and the syllabus.</span>
      </p>
    </div>
  </Section>

  {course.data.description && (
    <Section title="Course description" id="description">
      <div class="prose">{paras(course.data.description).map((p) => <p><Emph text={p} /></p>)}</div>
    </Section>
  )}

  <Section title="Modules" id="modules">
    <ol class="modules">
      {modules.map((m) => (
        <li id={`module-${m.data.number}`}>
          <p class="num sans">Module {m.data.number}</p>
          <h3>{m.data.title}</h3>
          {m.data.question && <p class="question">{m.data.question}</p>}
          <dl class="reading sans">
            {m.data.reading && <><dt>Recommended reading</dt><dd><Emph text={m.data.reading} /></dd></>}
            {m.data.additional_reading && <><dt>Additional reading</dt><dd><Emph text={m.data.additional_reading} /></dd></>}
          </dl>
          <p class="sans links"><a href={moduleSlides(course, m.data.number)}>Slides (PowerPoint)</a></p>
          {m.data.aims && (
            <details>
              <summary class="sans">Focus and aims</summary>
              {paras(m.data.aims).map((p) => <p><Emph text={p} /></p>)}
            </details>
          )}
        </li>
      ))}
    </ol>
  </Section>
</Base>

<style>
  .downloads { margin-top: 1.75rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .downloads p { margin: 0; font-size: var(--step--1); }
  .downloads .muted { display: block; margin-top: 0.2rem; color: var(--muted); }

  .modules { list-style: none; margin: 0; padding: 0; max-width: var(--measure); }
  .modules li { padding: 1.4rem 0; border-top: 1px solid var(--rule); }
  .modules li:first-child { padding-top: 0; border-top: 0; }
  .num { margin: 0 0 0.2rem; color: var(--muted); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.06em; }
  h3 { margin: 0; font-size: var(--step-1); font-weight: 500; line-height: 1.3; }
  .question { margin: 0.2rem 0 0; font-style: italic; color: var(--ink-soft); }
  .reading { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0.3rem 1.25rem; margin: 0.9rem 0 0; font-size: var(--step--1); }
  .reading dt { color: var(--muted); }
  .reading dd { margin: 0; }
  .links { margin: 0.7rem 0 0; font-size: var(--step--1); }
  details { margin-top: 0.5rem; }
  summary { cursor: pointer; color: var(--link); font-size: var(--step--1); }
  details p { margin: 0.75rem 0 0; color: var(--ink-soft); }
  @media (max-width: 620px) { .reading { grid-template-columns: 1fr; gap: 0.1rem; } .reading dd + dt { margin-top: 0.4rem; } }
</style>
