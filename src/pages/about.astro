---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import Section from '../components/Section.astro';
import CvDocument from '../components/CvDocument.astro';
import { getProfile, getSite, plain } from '../lib/data';
import { person } from '../lib/jsonld';
import Emph from '../components/Emph.astro';

const site = await getSite();
const profile = await getProfile();

// The PDF is generated from the same data on every build (scripts/cv/build-pdf.mjs).
const pdf = profile.cv_pdf;
---
<Base title="About" description={plain(profile.bio.short)} jsonLd={person(profile, site.url)}>
  <PageHeading slot="band" title={`About ${profile.given_name}`} intro={site.pages.about} />

  <Section title="Biography">
    <div class="bio">
      <div class="prose">
        {profile.bio.long.split(/\n\s*\n/).map((para) => <p><Emph text={para} /></p>)}
      </div>
      <img src={profile.photo.portrait} width="1119" height="1400" alt={profile.photo.alt} loading="lazy" />
    </div>
  </Section>

  <Section title="Curriculum vitae" id="cv">
    <p class="cv-links sans">
      {pdf ? <a class="button" href={pdf} download>Download CV (PDF)</a> : <span class="muted">PDF version coming soon</span>}
      {profile.links.google_scholar && <a href={profile.links.google_scholar}>Google Scholar</a>}
      {profile.links.researchgate && <a href={profile.links.researchgate}>ResearchGate</a>}
      {profile.links.orcid && <a href={profile.links.orcid}>ORCID</a>}
    </p>
    <CvDocument />
  </Section>
</Base>

<style>
  .bio { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .bio img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .cv-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin: 0 0 1.5rem; }
  @media (max-width: 820px) {
    .bio { grid-template-columns: 1fr; }
    .bio img { max-width: 18rem; }
  }
</style>
