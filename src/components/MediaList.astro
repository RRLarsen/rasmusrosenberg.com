---
/* Items on the Blog & Media page: thumbnail, title, outlet and a short summary. The first
   few show; the rest open with "Show more". All items are in the page for search engines
   and for visitors without JavaScript. */
import { formatDate } from '../lib/data';
import Emph from './Emph.astro';

export interface MediaItem {
  title: string;
  outlet: string;
  date?: string;
  summary?: string;
  image?: string;
  url?: string;
}
interface Props { items: MediaItem[]; initial?: number; empty: string }
const { items, initial = 4, empty } = Astro.props;
const label = (n: number) => `Show more (${n})`;
---
{items.length === 0 ? <p class="empty">{empty}</p> : (
  <div class="media-list" data-initial={initial}>
    <ul>
      {items.map((m, i) => (
        <li data-extra={i >= initial ? '' : undefined}>
          {m.image
            ? <img src={m.image} alt="" width="640" height="360" loading="lazy" />
            : <span class="tile" aria-hidden="true">{m.outlet}</span>}
          <div>
            <h3>{m.url ? <a href={m.url}><Emph text={m.title} /></a> : <Emph text={m.title} />}</h3>
            <p class="meta sans">{m.outlet}{m.date && `, ${formatDate(m.date)}`}</p>
            {m.summary && <p class="summary">{m.summary}</p>}
          </div>
        </li>
      ))}
    </ul>
    {items.length > initial && (
      <button type="button" class="more-btn sans" hidden data-more={label(items.length - initial)}>{label(items.length - initial)}</button>
    )}
  </div>
)}

<style>
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: 1.25rem; padding: 1.1rem 0; border-top: 1px solid var(--rule); align-items: start; }
  li:last-child { border-bottom: 1px solid var(--rule); }
  .media-list.collapsed li[data-extra] { display: none; }
  img, .tile { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: var(--rule); }
  .tile {
    display: flex; align-items: flex-end; padding: 0.6rem 0.7rem; background: var(--deep); color: var(--on-deep);
    font-family: var(--serif); font-size: 0.9375rem; line-height: 1.2; overflow: hidden;
  }
  h3 { margin: 0; font-size: 1.1875rem; font-weight: 500; line-height: 1.3; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--link); text-decoration: underline; }
  .meta { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.875rem; }
  .summary { margin: 0.5rem 0 0; font-size: 1.0625rem; line-height: 1.5; color: var(--ink-soft); max-width: var(--measure); }
  .more-btn {
    margin-top: 1rem; padding: 0.55rem 1rem; background: none; border: 1px solid var(--rule); border-radius: 2px;
    color: var(--ink); cursor: pointer; font-size: 0.9375rem;
  }
  .more-btn:hover { border-color: var(--ink-soft); }
  @media (max-width: 620px) {
    li { grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.9rem; }
    .tile { font-size: 0.75rem; padding: 0.4rem 0.5rem; }
    h3 { font-size: 1.0625rem; }
    .summary { font-size: 1rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.media-list').forEach((list) => {
    const btn = list.querySelector<HTMLButtonElement>('.more-btn');
    if (!btn) return;
    list.classList.add('collapsed');
    btn.hidden = false;
    btn.setAttribute('aria-expanded', 'false');
    btn.addEventListener('click', () => {
      const open = list.classList.toggle('collapsed') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Show fewer' : btn.dataset.more ?? 'Show more';
      if (!open) list.scrollIntoView({ block: 'nearest' });
    });
  });
</script>
