---
/* The template for a promotion in the home-page band. Every promotion has the same parts in
   the same place: a 16:9 image frame (or a tile with the source's name), the title, a short
   standard description (who, where, when), and one action link. */
import type { Promotion } from '../lib/promotions';

interface Props { promo: Promotion; active: boolean }
const { promo, active } = Astro.props;
---
<div class="promo">
  <div class="frame">
    {promo.image
      ? <img src={promo.image} alt={promo.source} width="1000" height="562" loading="lazy" />
      : <span class="tile" aria-hidden="true">{promo.source}</span>}
  </div>
  <div>
    <p class="title">{promo.title}</p>
    <p class="description sans">{promo.description}</p>
    {promo.url && <a class="action sans" href={promo.url} tabindex={active ? undefined : -1}>{promo.action}</a>}
  </div>
</div>

<style>
  .promo { display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: 1.5rem; align-items: center; }
  .frame { aspect-ratio: 16 / 9; overflow: hidden; background: var(--deep-2); }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  .tile { display: flex; align-items: flex-end; height: 100%; padding: 0.75rem; font-size: 1.125rem; line-height: 1.2; color: var(--on-deep); }
  .title { margin: 0; font-weight: 300; font-size: clamp(1.5rem, 2.4vw, 2.125rem); line-height: 1.15; letter-spacing: -0.01em; }
  .description { margin: 0.6rem 0 0; color: var(--on-deep-soft); max-width: 32rem; }
  .action { display: inline-block; margin-top: 0.8rem; }
  @media (max-width: 820px) {
    .promo { grid-template-columns: 1fr; gap: 0.9rem; }
    .frame { max-width: 18rem; }
  }
</style>
