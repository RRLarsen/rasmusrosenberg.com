---
/* The full academic CV on the About page. Content and order come from the shared CV model
   (src/lib/cv.ts), which the PDF CV also uses. Student names never appear here. */
import { buildCv } from '../lib/cv';
import { runsToHtml } from '../lib/cite';

const cv = await buildCv();
const tag = { 1: 'h4', 2: 'h5', 3: 'h6' } as const;
---
<article class="cv" tabindex="0" aria-label="Curriculum vitae">
  <header>
    <h3 class="cv-name">{cv.name}</h3>
    <p class="sans">{cv.headline.join('. ')}.<br /><Fragment set:html={runsToHtml(cv.contact)} /></p>
  </header>

  {cv.blocks.map((b) => {
    const H = tag[b.level];
    return (
      <>
        {b.title && <H class={`l${b.level}`}>{b.title}</H>}
        {b.kind === 'dated' && (
          <ul class="dated">{b.entries!.map((e) => <li><span class="when">{e.when}</span><span set:html={runsToHtml(e.runs)} /></li>)}</ul>
        )}
        {b.kind === 'facts' && (
          <dl class="facts">{b.entries!.map((e) => <><dt>{e.when}</dt><dd set:html={runsToHtml(e.runs)} /></>)}</dl>
        )}
        {(b.kind === 'refs' || b.kind === 'list') && (
          <ol class="hang">{b.entries!.map((e) => <li set:html={runsToHtml(e.runs)} />)}</ol>
        )}
        {b.kind === 'text' && b.entries!.map((e) => <p class="plain" set:html={runsToHtml(e.runs)} />)}
      </>
    );
  })}
</article>

<style>
  .cv {
    max-height: 80vh; overflow-y: auto; overscroll-behavior: contain;
    background: color-mix(in srgb, var(--paper) 60%, white); border: 1px solid var(--rule);
    padding: clamp(1.5rem, 4vw, 3rem); font-size: 1rem; line-height: 1.5;
  }
  @media (prefers-color-scheme: dark) { .cv { background: color-mix(in srgb, var(--paper) 85%, white); } }
  header { border-bottom: 1px solid var(--rule); padding-bottom: 1.25rem; margin-bottom: 0.5rem; }
  .cv-name { margin: 0 0 0.4rem; font-size: 1.75rem; font-weight: 400; }
  header p { margin: 0; color: var(--ink-soft); }
  .l1 { margin: 1.75rem 0 0.25rem; font-size: 1.25rem; font-weight: 500; }
  .l2 { margin: 1.25rem 0 0.5rem; font-family: var(--sans); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.03em; color: var(--muted); }
  .l3 { margin: 0.9rem 0 0.4rem; font-size: 1rem; font-weight: 500; font-style: italic; }
  ul, ol { margin: 0; padding: 0; list-style: none; }
  .dated li { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; padding: 0.2rem 0; }
  .when { font-family: var(--sans); font-size: 0.8125rem; color: var(--muted); padding-top: 0.15rem; }
  .hang li { padding-left: 1.5rem; text-indent: -1.5rem; margin-bottom: 0.5rem; }
  .cv :global(a) { overflow-wrap: anywhere; }
  .facts { display: grid; grid-template-columns: 8rem 1fr; gap: 0.2rem 1rem; margin: 0.5rem 0 0; }
  .facts dt { font-family: var(--sans); font-size: 0.8125rem; color: var(--muted); padding-top: 0.15rem; }
  .facts dd { margin: 0; }
  .plain { margin: 0 0 0.4rem; }
  @media (max-width: 820px) {
    .cv { max-height: none; overflow: visible; }
    .dated li, .facts { grid-template-columns: 1fr; gap: 0; }
  }
</style>
