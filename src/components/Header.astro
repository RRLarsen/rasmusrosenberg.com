---
import { getProfile } from '../lib/data';
import Wordmark from './Wordmark.astro';

const profile = await getProfile();
const nav = [
  { href: '/research/', label: 'Research' },
  { href: '/expertise/', label: 'Expertise' },
  { href: '/media/', label: 'Media' },
  { href: '/teaching/', label: 'Teaching' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="wrap top sans">
  <Wordmark name={profile.name} />
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
  <nav id="site-nav" aria-label="Main">
    {/* home: a house icon on wide screens, the word "Home" in the phone menu */}
    <a class="home" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <svg aria-hidden="true" viewBox="0 1.5 24 20" width="18" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9v11.5h13V9"/><path d="M10 20.5v-6h4v6"/></svg>
      <span class="home-label">Home</span>
    </a>
    {nav.map((item) => (
      <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const nav = document.getElementById('site-nav')!;
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
  });
</script>

<style>
  .top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; padding-top: 1.1rem; padding-bottom: 1.1rem; }
  /* items share the text's baseline, so the house's bottom edge sits on the same line as the letters */
  nav { display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: baseline; }
  nav a { text-decoration: none; color: var(--on-deep-soft); }
  nav a:hover, nav a[aria-current="page"] { color: var(--on-deep); text-decoration: underline; }
  button {
    font: inherit; background: none; color: var(--on-deep-soft); cursor: pointer;
    border: 1px solid rgb(255 255 255 / 0.25); border-radius: 2rem; padding: 0.2rem 0.8rem;
  }
  button:hover { color: var(--on-deep); border-color: rgb(255 255 255 / 0.5); }
  .menu-toggle { display: none; }
  .home { display: inline-flex; align-items: baseline; gap: 0.4rem; }
  .home svg { display: block; align-self: baseline; } /* the drawing reaches the bottom of its box, which sits on the baseline */
  /* the same soft colour as the other menu items, also on the home page itself */
  nav a.home[aria-current="page"] { color: var(--on-deep-soft); }
  nav a.home:hover { color: var(--on-deep); }
  /* on wide screens only the icon shows; the label stays for screen readers */
  .home-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 960px) {
    .menu-toggle { display: inline-block; }
    nav { display: none; flex-basis: 100%; flex-direction: column; align-items: flex-start; gap: 0.25rem; padding-top: 0.75rem; }
    nav.open { display: flex; }
    nav a { padding: 0.35rem 0; font-size: 1.0625rem; }
    .home svg { display: none; }
    .home-label { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
  }
</style>
